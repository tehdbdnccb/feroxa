ENVIRONMENT=development
DATABASE_URL=sqlite:///./fixora.db
JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret
JWT_EXPIRES_MINUTES=60
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_CALLBACK_TOKEN=replace-with-a-long-random-token

# Object storage. Leave STORAGE_BUCKET empty for local development.
MEDIA_ROOT=./media
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
MAX_UPLOAD_MB=10
PLATFORM_FEE_PERCENT=15
